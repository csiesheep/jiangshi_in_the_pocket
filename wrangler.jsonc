{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jiangshi-in-the-pocket",
  "compatibility_date": "2026-08-14",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  // Attached to the shared hostname by path-scoped Routes, NOT a Custom Domain
  // — the `games` hub Worker holds that. Cloudflare matches the most-specific
  // route first, so these peel /jiangshi_in_the_pocket off the hub.
  // Two patterns: `/*` does not match the bare prefix, and the bare prefix is
  // what src/index.js redirects to the trailing-slash form.
  "routes": [
    { "pattern": "games.csiesheep.com/jiangshi_in_the_pocket", "zone_name": "csiesheep.com" },
    { "pattern": "games.csiesheep.com/jiangshi_in_the_pocket/*", "zone_name": "csiesheep.com" }
  ],
  // The leaderboard's database (#143). Created 2026-08-31 on the owner's
  // account; the id is a name, not a secret — access comes from the account
  // and this binding. The table lives in sql/schema.sql, applied by hand.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jiangshi-leaderboard",
      "database_id": "af8a25df-9ea0-47b8-aea9-cdbeba3b1715"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
